# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=<GEMINI_MODEL_API_KEY>

# NewsAPI.org key (https://newsapi.org)
NEWS_API_ORG=<NEWS_API_ORG_KEY>
# Currents API key (https://currentsapi.services)
CURRENT_API_SERVICES=<CURRENTS_API_KEY>

# Set to "true" to use bundled mock responses instead of calling news APIs / the LLM
USE_MOCK_DATA=false

# WhatsApp Cloud API config
WHATSAPP_API_ACCESS_TOKEN=<WHATSAPP_TOKEN>
WHATSAPP_SENDER_ACCOUNT_ID=<SENDER_PHONE_NUMBER_ID>
WHATSAPP_RECIPIENT_NUMBER=<RECIPIENT_PHONE_NUMBER>
